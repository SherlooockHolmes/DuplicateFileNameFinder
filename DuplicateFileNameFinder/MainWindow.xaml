<Window x:Class="MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate Word Finder" 
        FontFamily="Trebuchet MS"
        FontSize="14"
        FontWeight="Regular"
        FlowDirection="LeftToRight"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        Width="800"
        Height="600"> 
    <Grid Margin="10,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Label Content="Duplicate Filename Finder" FontFamily="Times New Roman" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
            <Label Content="Version 1.0.0.0" HorizontalAlignment="Center" />
            <Label Content="Created by: Mohammad  Gol ara" HorizontalAlignment="Center" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Select Folder" Width="100" Grid.Column="0" Click="BtnSelectFolder_Click" />
            <TextBox x:Name="TxtFolder" IsReadOnly="True" IsReadOnlyCaretVisible="True" Grid.Column="1" BorderThickness="1" BorderBrush="Black" VerticalContentAlignment="Center" Margin="10,0,0,0" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ChkCaseSensitiveFilenames" Grid.Column="1" Content="Case Sensitive Filenames" IsChecked="True" Margin="10,0,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="ChkCaseSensitiveFilenames_Click" />
            <CheckBox x:Name="ChkIncludeExtension" Grid.Column="2" Content="Also Analyze Extension" Margin="10,0,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="ChkIncludeExtension_Click" />
            <CheckBox x:Name="ChkIgnoreEqualFilenames" Grid.Column="3" Content="Ignore Equal Filenames" IsChecked="True" Margin="10,0,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="ChkIgnoreEqualFilenames_Click" />
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Excepted words (Split with ','):" />
            <TextBox x:Name="TxtIgnoreWords" TextChanged="TxtIgnoreWords_TextChanged" />
        </StackPanel>
        <TreeView x:Name="TreeResult" Grid.Row="4" Margin="0,15,0,0" />
    </Grid>
</Window>
